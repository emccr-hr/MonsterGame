{
  "name": "magic-and-monsters",
  "private": true,
  "version": "0.0.0",
  "description": "A monster-catching browser game designed by a 10-year-old.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint . && tsc --noEmit",
    "lint:spelling": "node scripts/check-us-spelling.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "ci:local": "node scripts/ci-local.mjs",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
